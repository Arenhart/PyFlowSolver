   "source": [
    "def split_into_bins(x, n):\n",
    "    bins = []\n",
    "    for i in range(n):\n",
    "        start = i * x // n\n",
    "        end = (i + 1) * x // n\n",
    "        bins.append((start, end))\n",
    "    return bins\n",
    "\n",
    "# Example usage:\n",
    "x = 10\n",
    "n = 3\n",
    "bins = split_into_bins(x, n)\n",
    "bins"
   ]
  },
